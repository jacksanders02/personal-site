---
const FONTS = [
    'Manrope:wght@200..800',
]

const fontString = FONTS.map(font => `family=${font}`).join('&')

const fontLinks = 'https://fonts.googleapis.com/css2?' + fontString + '&display=swap'
---

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href={fontLinks} rel="stylesheet">