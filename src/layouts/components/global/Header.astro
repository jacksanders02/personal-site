---
import { socialLinks } from '../../../config/site';

const navLinks = [
  { label: 'About',    href: '/#about' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Blog',     href: '/blog' },
  { label: 'The Box',  href: '/the-box' },
  { label: 'Contact',  href: '/#contact' },
];

const headerSocials = socialLinks.filter(l => l.label !== 'Email');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo">JS</a>

    <nav class="site-nav" aria-label="Main navigation">
      <ul class="site-nav__list" role="list">
        {navLinks.map(link => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__social">
      {headerSocials.map(link => (
        <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label} set:html={link.icon} />
      ))}
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);

    &__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 4rem;
      gap: var(--space-8);
    }

    &__logo {
      font-size: var(--text-lg);
      font-weight: var(--weight-extrabold);
      color: var(--color-text);
      letter-spacing: -0.04em;
      text-transform: uppercase;
      flex-shrink: 0;

      &:hover {
        color: var(--color-accent);
      }
    }

    &__social {
      display: flex;
      gap: var(--space-4);
      flex-shrink: 0;

      a {
        color: var(--color-muted);
        transition: color var(--transition-fast);
        line-height: 0;

        &:hover {
          color: var(--color-accent);
        }
      }
    }
  }

  .site-nav {
    &__list {
      display: flex;
      gap: var(--space-8);
      list-style: none;

      a {
        font-size: var(--text-sm);
        font-weight: var(--weight-semibold);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-muted);
        transition: color var(--transition-fast);

        &:hover {
          color: var(--color-text);
        }
      }
    }
  }

  @media (max-width: 640px) {
    .site-nav {
      display: none;
    }

    .site-header__social {
      gap: var(--space-3);
    }
  }
</style>
