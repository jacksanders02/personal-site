---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
};

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const formattedUpdated = post.data.updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={`${post.data.title} — Jack Sanders`} description={post.data.description}>
  <main class="section">
    <div class="container">
      <article class="post">
        <header class="post__header">
          <a href="/blog" class="post__back">← All Posts</a>
          <div class="post__meta">
            <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
            {formattedUpdated && (
              <span>
                Updated <time datetime={post.data.updatedDate!.toISOString()}>{formattedUpdated}</time>
              </span>
            )}
          </div>
          <h1 class="post__title">{post.data.title}</h1>
          <p class="post__desc">{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <ul class="post__tags" role="list">
              {post.data.tags.map(tag => <li>{tag}</li>)}
            </ul>
          )}
        </header>

        <div class="post__body prose">
          <Content />
        </div>
      </article>
    </div>
  </main>
</Layout>

<style>
  .post {
    max-width: 72ch;

    &__back {
      display: inline-block;
      font-size: var(--text-sm);
      font-weight: var(--weight-semibold);
      letter-spacing: 0.04em;
      color: var(--color-muted);
      margin-bottom: var(--space-12);
      transition: color var(--transition-fast);

      &:hover {
        color: var(--color-accent);
      }
    }

    &__meta {
      display: flex;
      gap: var(--space-6);
      font-size: var(--text-sm);
      color: var(--color-muted);
      margin-bottom: var(--space-6);
    }

    &__title {
      font-size: var(--text-5xl);
      font-weight: var(--weight-extrabold);
      letter-spacing: -0.04em;
      line-height: 1;
      margin-bottom: var(--space-6);
    }

    &__desc {
      font-size: var(--text-xl);
      color: var(--color-muted);
      line-height: 1.5;
      margin-bottom: var(--space-6);
    }

    &__tags {
      list-style: none;
      display: flex;
      gap: var(--space-3);
      flex-wrap: wrap;
      margin-bottom: var(--space-16);
      padding-top: var(--space-6);
      border-top: 1px solid var(--color-border);

      li {
        font-size: var(--text-xs);
        font-weight: var(--weight-semibold);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-accent);
      }
    }
  }
</style>
