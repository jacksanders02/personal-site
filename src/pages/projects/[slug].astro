---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('projects', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
};

interface Props {
  post: CollectionEntry<'projects'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} — Jack Sanders`} description={post.data.description}>
  <main class="section">
    <div class="container">
      <article class="project-writeup">
        <header class="project-writeup__header">
          <a href="/#projects" class="project-writeup__back">← All Projects</a>
          <div class="project-writeup__meta">
            <span>{post.data.date}</span>
          </div>
          <h1 class="project-writeup__title">{post.data.title}</h1>
          <p class="project-writeup__desc">{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <ul class="project-writeup__tags" role="list">
              {post.data.tags.map(tag => <li>{tag}</li>)}
            </ul>
          )}
          {post.data.repo && (
            <a href={post.data.repo} target="_blank" rel="noopener noreferrer" class="project-writeup__repo">
              View on GitHub
            </a>
          )}
        </header>

        <div class="project-writeup__body prose">
          <Content />
        </div>
      </article>
    </div>
  </main>
</Layout>

<style>
  .project-writeup {
    max-width: 72ch;

    &__back {
      display: inline-block;
      font-size: var(--text-sm);
      font-weight: var(--weight-semibold);
      letter-spacing: 0.04em;
      color: var(--color-muted);
      margin-bottom: var(--space-12);
      transition: color var(--transition-fast);

      &:hover {
        color: var(--color-accent);
      }
    }

    &__meta {
      display: flex;
      gap: var(--space-6);
      font-size: var(--text-sm);
      color: var(--color-muted);
      margin-bottom: var(--space-6);
    }

    &__title {
      font-size: var(--text-5xl);
      font-weight: var(--weight-extrabold);
      letter-spacing: -0.04em;
      line-height: 1;
      margin-bottom: var(--space-6);
    }

    &__desc {
      font-size: var(--text-xl);
      color: var(--color-muted);
      line-height: 1.5;
      margin-bottom: var(--space-6);
    }

    &__tags {
      list-style: none;
      display: flex;
      gap: var(--space-3);
      flex-wrap: wrap;
      margin-bottom: var(--space-6);
      padding-top: var(--space-6);
      border-top: 1px solid var(--color-border);

      li {
        font-size: var(--text-xs);
        font-weight: var(--weight-semibold);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-accent);
      }
    }

    &__repo {
      display: inline-block;
      font-size: var(--text-sm);
      font-weight: var(--weight-semibold);
      letter-spacing: 0.04em;
      color: var(--color-accent);
      margin-bottom: var(--space-16);
      transition: color var(--transition-fast);

      &:hover {
        color: var(--color-accent-hover);
      }
    }
  }
</style>
