---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('projects', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
};

interface Props {
  post: CollectionEntry<'projects'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} — Jack Sanders`} description={post.data.description}>
  <main class="section">
    <div class="container">
      <article class="project-writeup">
        <header class="project-writeup__header">
          <a href="/#projects" class="project-writeup__back">← All Projects</a>
          <div class="project-writeup__meta">
            <span>{post.data.date}</span>
          </div>
          <h1 class="project-writeup__title">{post.data.title}</h1>
          <p class="project-writeup__desc">{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <ul class="project-writeup__tags" role="list">
              {post.data.tags.map(tag => <li>{tag}</li>)}
            </ul>
          )}
          {post.data.repoUrl && (
            <a href={post.data.repoUrl} target="_blank" rel="noopener noreferrer" class="project-writeup__repo">
              View on GitHub
            </a>
          )}
        </header>

        <div class="project-writeup__body prose">
          <Content />
        </div>
      </article>
    </div>
  </main>
</Layout>

<style>
  .project-writeup {
    max-width: 72ch;

    &__back {
      display: inline-block;
      font-size: var(--text-sm);
      font-weight: var(--weight-semibold);
      letter-spacing: 0.04em;
      color: var(--color-muted);
      margin-bottom: var(--space-12);
      transition: color var(--transition-fast);

      &:hover {
        color: var(--color-accent);
      }
    }

    &__meta {
      display: flex;
      gap: var(--space-6);
      font-size: var(--text-sm);
      color: var(--color-muted);
      margin-bottom: var(--space-6);
    }

    &__title {
      font-size: var(--text-5xl);
      font-weight: var(--weight-extrabold);
      letter-spacing: -0.04em;
      line-height: 1;
      margin-bottom: var(--space-6);
    }

    &__desc {
      font-size: var(--text-xl);
      color: var(--color-muted);
      line-height: 1.5;
      margin-bottom: var(--space-6);
    }

    &__tags {
      list-style: none;
      display: flex;
      gap: var(--space-3);
      flex-wrap: wrap;
      margin-bottom: var(--space-6);
      padding-top: var(--space-6);
      border-top: 1px solid var(--color-border);

      li {
        font-size: var(--text-xs);
        font-weight: var(--weight-semibold);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-accent);
      }
    }

    &__repo {
      display: inline-block;
      font-size: var(--text-sm);
      font-weight: var(--weight-semibold);
      letter-spacing: 0.04em;
      color: var(--color-accent);
      margin-bottom: var(--space-16);
      transition: color var(--transition-fast);

      &:hover {
        color: var(--color-accent-hover);
      }
    }
  }

  /* ─── Prose styles ──────────────────────────────────── */
  .prose {
    font-size: var(--text-lg);
    line-height: 1.75;
    color: var(--color-text);

    :global(h2) {
      font-size: var(--text-4xl);
      font-weight: var(--weight-extrabold);
      letter-spacing: -0.03em;
      line-height: 1.1;
      margin-top: var(--space-16);
      margin-bottom: var(--space-6);
    }

    :global(h3) {
      font-size: var(--text-3xl);
      font-weight: var(--weight-bold);
      letter-spacing: -0.02em;
      line-height: 1.2;
      margin-top: var(--space-12);
      margin-bottom: var(--space-4);
    }

    :global(p) {
      margin-bottom: var(--space-6);
    }

    :global(a) {
      color: var(--color-accent);
      text-decoration: underline;
      text-underline-offset: 3px;

      &:hover {
        color: var(--color-accent-hover);
      }
    }

    :global(strong) {
      font-weight: var(--weight-bold);
      color: var(--color-text);
    }

    :global(em) {
      font-style: italic;
    }

    :global(ul),
    :global(ol) {
      margin-bottom: var(--space-6);
      padding-left: var(--space-8);

      :global(li) {
        margin-bottom: var(--space-2);
      }
    }

    :global(blockquote) {
      border-left: 3px solid var(--color-accent);
      padding-left: var(--space-6);
      color: var(--color-muted);
      font-style: italic;
      margin-block: var(--space-8);
    }

    :global(code) {
      font-family: var(--font-mono);
      font-size: 0.875em;
      background-color: var(--color-surface);
      border: 1px solid var(--color-border);
      padding: 0.1em 0.4em;
      border-radius: var(--radius-sm);
    }

    :global(pre) {
      background-color: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: var(--space-6);
      overflow-x: auto;
      margin-bottom: var(--space-8);
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      line-height: 1.7;

      :global(code) {
        background: none;
        border: none;
        padding: 0;
        font-size: inherit;
      }
    }

    :global(hr) {
      border: none;
      border-top: 1px solid var(--color-border);
      margin-block: var(--space-12);
    }

    :global(img) {
      border-radius: var(--radius-md);
      margin-block: var(--space-8);
    }
  }
</style>
