---
import Layout from '../../layouts/Layout.astro';
import { theBox } from '../../config/site';
---

<Layout title="The Box — Jack Sanders" description="A box of random projects, tools, and experiments.">
  <main class="section">
    <div class="container">
      <h1 class="section-title">The Box</h1>
      <p class="page-intro">
        A dumping ground for random projects, mini-apps, experiments, and anything else that doesn't have a better home.
      </p>

      {theBox.length === 0 ? (
        <p class="empty">Nothing in the box yet — check back soon.</p>
      ) : (
        <ol class="tool-list" role="list">
          {theBox.map(tool => (
            <li class="tool-item">
              <div class="tool-item__body">
                <h2 class="tool-item__title">
                  {tool.url ? (
                    <a
                      href={tool.url}
                      target={tool.url.startsWith('/') ? undefined : '_blank'}
                      rel={tool.url.startsWith('/') ? undefined : 'noopener noreferrer'}
                    >
                      {tool.title}
                    </a>
                  ) : (
                    tool.title
                  )}
                </h2>
                <p class="tool-item__desc">{tool.description}</p>
                {tool.tags.length > 0 && (
                  <ul class="tool-item__tags" role="list">
                    {tool.tags.map(tag => <li>{tag}</li>)}
                  </ul>
                )}
              </div>
              {tool.repo && (
                <div class="tool-item__links">
                  <a
                    href={tool.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`GitHub repo for ${tool.title}`}
                    class="tool-item__repo"
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.014-1.703-2.782.604-3.369-1.341-3.369-1.341-.454-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
                    </svg>
                  </a>
                </div>
              )}
            </li>
          ))}
        </ol>
      )}
    </div>
  </main>
</Layout>

<style>
  .page-intro {
    font-size: var(--text-lg);
    color: var(--color-muted);
    max-width: 52ch;
    margin-bottom: var(--space-16);
    line-height: 1.6;
  }

  .empty {
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  .tool-list {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .tool-item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-8);
    align-items: start;
    padding-block: var(--space-10);
    border-bottom: 1px solid var(--color-border);
    transition: background-color var(--transition-fast);

    &:hover {
      background-color: var(--color-surface);
    }

    &__title {
      font-size: var(--text-2xl);
      font-weight: var(--weight-extrabold);
      letter-spacing: -0.03em;
      margin-bottom: var(--space-3);

      a {
        color: var(--color-text);
        transition: color var(--transition-fast);

        &:hover {
          color: var(--color-accent);
        }
      }
    }

    &__desc {
      color: var(--color-muted);
      font-size: var(--text-base);
      line-height: 1.6;
      max-width: 60ch;
      margin-bottom: var(--space-4);
    }

    &__tags {
      list-style: none;
      display: flex;
      gap: var(--space-2);
      flex-wrap: wrap;

      li {
        font-size: var(--text-xs);
        font-weight: var(--weight-semibold);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-muted);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        padding: var(--space-1) var(--space-3);
        border-radius: var(--radius-sm);
      }
    }

    &__links {
      padding-top: 0.4em;
    }

    &__repo {
      color: var(--color-muted);
      transition: color var(--transition-fast);
      line-height: 0;

      &:hover {
        color: var(--color-accent);
      }
    }
  }

  @media (max-width: 640px) {
    .tool-item {
      grid-template-columns: 1fr;

      &__links {
        display: none;
      }
    }
  }
</style>
